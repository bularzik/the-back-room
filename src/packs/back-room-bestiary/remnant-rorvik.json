  {
   "_id": "fkImMbY1b2UTJen2",
   "name": "The Blank",
   "type": "feat",
   "img": "icons/magic/symbols/question-stone-yellow.webp",
   "system": {
    "type": {
     "value": "monster",
     "subtype": ""
    },
    "activities": {},
    "uses": {
     "spent": 0,
     "recovery": [],
     "max": ""
    },
    "description": {
     "value": "<p>Nobody remembers his adventures, and neither does he: his player was usually the one running the game, so Rorvik spent most of his life waiting for a turn. He asks, every few minutes, whether it is his turn yet. He cannot let an insult go: anyone who mocks him has his complete attention, and the Remnant rule that it never attacks first does not survive being called a coward.</p>",
     "chat": ""
    },
    "identifier": "the-blank",
    "source": {

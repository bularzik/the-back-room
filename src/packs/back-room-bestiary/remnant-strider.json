  {
   "_id": "ETC0z2jFcMPhIp2k",
   "name": "Stands Back Up",
   "type": "feat",
   "img": "icons/magic/life/heart-cross-green.webp",
   "system": {
    "type": {
     "value": "monster",
     "subtype": ""
    },
    "activities": {},
    "uses": {
     "spent": 0,
     "recovery": [],
     "max": ""
    },
    "description": {
     "value": "<p><strong>The Remnant Rule.</strong> When this creature drops to 0 Hit Points it does not die. At the start of its next turn it stands up in the pose it fell in, with all its Hit Points, and continues mid-sentence. The only way to be rid of it is to leave the room by a door it did not come through; it cannot follow.</p>",
     "chat": ""
    },

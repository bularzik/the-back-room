   },
   "_key": "!actors.items!xEs0PM9DU2T204Sv.Il7T9RpszGqCkEsG"
  },
  {
   "_id": "fMHE9HImTqFHxc7r",
   "name": "The Blank",
   "type": "feat",
   "img": "icons/magic/symbols/question-stone-yellow.webp",
   "system": {
    "type": {
     "value": "monster",
     "subtype": ""
    },
    "activities": {},
    "uses": {
     "spent": 0,
     "recovery": [],
     "max": ""
    },
    "description": {
     "value": "<p>He has his character sheet, and he will show it to you: seventh level, sixty thousand three hundred and eighty-one experience points, every box filled in, the paper soft and scorched in one corner. The name line says only <em>T. Morlock</em>. Nobody knows what the T. stands for, and he gets quieter each time someone asks.</p>",
     "chat": ""
    },
    "identifier": "the-blank",
    "source": {

 "items": [
  {
   "_id": "Il7T9RpszGqCkEsG",
   "name": "Signature: Thief-Acrobat",
   "type": "feat",
   "img": "icons/magic/symbols/runes-star-orange-purple.webp",
   "system": {
    "type": {
     "value": "monster",
     "subtype": ""
    },
    "activities": {},
    "uses": {
     "spent": 0,
     "recovery": [],
     "max": ""
    },
    "description": {
     "value": "<p>Once per round, one acrobatic move succeeds without a roll (his sheet says tightrope 100%, and he means it): a tumble through an enemy's space, a pole vault of nine and a half feet onto a table or a balcony, a run along a rail or a rope, a fall of up to twenty feet landed on his feet. None of it provokes Opportunity Attacks. The first hit he makes after a move like that in the same round is a backstab: triple damage dice.</p>",
     "chat": ""
    },
    "identifier": "signature-thief-acrobat",
    "source": {
     "revision": 1,
     "rules": "2024",
     "book": "The Back Room",
     "license": ""
    },
    "properties": [
     "trait"
    ],
    "requirements": ""
   },
   "effects": [],
   "flags": {},
